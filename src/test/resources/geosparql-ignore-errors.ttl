@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ex: <http://example.com/ignore-errors/> .

ex:container a geo:Geometry ;
	geo:asWKT "POLYGON((0 0, 0 10, 10 10, 10 0, 0 0))"^^geo:wktLiteral .

ex:validWkt a geo:Geometry ;
	geo:asWKT "POINT(1 1)"^^geo:wktLiteral .

ex:invalidWkt a geo:Geometry ;
	geo:asWKT "NOT A GEOMETRY"^^geo:wktLiteral .

ex:validGml a geo:Geometry ;
	geo:asGML """<gml:Point xmlns:gml="http://www.opengis.net/gml/3.2" srsName="http://www.opengis.net/def/crs/OGC/1.3/CRS84"><gml:pos>2 2</gml:pos></gml:Point>"""^^geo:gmlLiteral .

ex:invalidGml a geo:Geometry ;
	geo:asGML """<gml:Point xmlns:gml="http://www.opengis.net/gml/3.2" srsName="http://www.opengis.net/def/crs/OGC/1.3/CRS84"><gml:pos>3 3</gml:pos>"""^^geo:gmlLiteral .
