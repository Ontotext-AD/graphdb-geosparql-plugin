@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix my: <http://example.org/ApplicationSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sf: <http://www.opengis.net/ont/sf#> .

my:PlaceOfInterest a rdfs:Class;
  rdfs:subClassOf geo:Feature .

my:hasExactGeometry a rdf:Property;
  rdfs:subPropertyOf geo:hasDefaultGeometry, geo:hasGeometry .

<<my:A rdf:type my:PlaceOfInterest>> my:hasExactGeometry my:AGeometry .
<<my:B rdf:type my:PlaceOfInterest>> my:hasExactGeometry my:BGeometry .
<<my:C rdf:type my:PlaceOfInterest>> my:hasExactGeometry my:CGeometry .

my:AGeometry a sf:Polygon;
  geo:asWKT "POLYGON((0 0,0 10,10 10,10 0,0 0))"^^geo:wktLiteral .

my:BGeometry a sf:Polygon;
  geo:asWKT "POLYGON((2 2,2 4,4 4,4 2,2 2))"^^geo:wktLiteral .

my:CGeometry a sf:Polygon;
  geo:asWKT "POLYGON((3 3,3 12,12 12,12 3,3 3))"^^geo:wktLiteral .
